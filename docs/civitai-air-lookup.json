    },
    "getRecipeWithoutBody": {
      "url": "GET https://orchestration.civitai.com/v2/consumer/recipes/customComfy",
      "status": 405
    },
    "inputSchema": {
      "name": "CustomComfyInput",
      "required": [
        "resources",
        "trace",
        "workflow"
      ],
      "optional": [
        "sessionId",
        "comfyImage",
        "sessionOwnerApiToken",
        "minVramGb",
        "useSageAttention",
        "minimumDurationSeconds"
      ],
      "resources": {
        "type": "array",
        "minItems": 1,
        "items": "string",
        "notObjects": true,
        "description": "AIR URNs. Checkpoints/loras/vae AND comfy:nodepack. Orchestrator does not scan the workflow.",
        "example": "urn:air:comfy:nodepack:comfyregistry:kijai/comfyui-kjnodes@1.4.0"
      },
      "workflow": "opaque ComfyUI graph",
      "trace": {
        "enum": [
          "none",
          "logs",
          "binary"
        ]
      },
      "comfyImageExample": "urn:air:oci:image:ghcr:civitai/civitai-spine-comfy@v2.5.5",
      "airPattern": "^(?:urn:)?(?:air:)?(?:(?<ecosystem>[a-zA-Z0-9_\\-\\/]+):)?(?:(?<type>[a-zA-Z0-9_\\-\\/]+):)?(?<source>[a-zA-Z0-9_\\-\\/]+):(?<id>[a-zA-Z0-9_\\-\\/\\.]+)(?:@(?<version>[a-zA-Z0-9_\\-\\/.=,%+:]+))?(?:\\.(?<format>[a-zA-Z0-9_\\-]+))?$",
      "sessionOwnerApiToken": "sensitive — never log"
    },
    "snapshotNote": "comfyNodepackSnapshot output.layerAir is urn:air:comfy:nodepacklayer:…@<ver>+<hex(image)>. That recipe OpenAPI says declare layerAir on customComfy resources. Snapshot submit is POST and was not called."
  },
  "airFormat": {
